# ─── Postgres ────────────────────────────────────────────────
POSTGRES_USER=tryon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tryon_prod

DATABASE_URL=postgres://tryon:CHANGE_ME_STRONG_PASSWORD@aivastra-prod-postgres:5432/tryon_prod

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://aivastra-prod-redis:6379

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
COOKIE_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# ─── Admin ───────────────────────────────────────────────────
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Cloudflare R2 ───────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
# Public R2 URL or custom domain (no trailing slash)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ─── ComfyUI Workers ─────────────────────────────────────────
WORKER_A_URL=http://your-worker-ip:8000
WORKER_A_CF_CLIENT_ID=
WORKER_A_CF_CLIENT_SECRET=

# ─── Web (baked into Next.js build) ─────────────────────────
# Must match the domain CloudPanel routes to the API container
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
