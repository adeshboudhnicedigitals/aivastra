{
  "name": "aivastra",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @aivastra/db run generate",
    "db:migrate": "pnpm --filter @aivastra/db run migrate",
    "seed:catalog": "pnpm --filter @aivastra/scripts run seed:catalog",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f infra/docker-compose.yml down -v",
    "backfill:thumbnails": "tsx --env-file=.env scripts/backfill-thumbnails.mts"
  },
  "devDependencies": {
    "@aivastra/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.673.0",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.7.5",
    "lefthook": "^2.1.8",
    "sharp": "^0.33.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
