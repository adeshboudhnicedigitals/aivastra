# Optional direct Grafana dashboard URLs. Public build-time settings; rebuild after editing.
# Leave unset to show "Not configured". Never put tokens in these URLs.
VITE_GRAFANA_GPU_URL=
VITE_GRAFANA_HOST_URL=
VITE_GRAFANA_PERFORMANCE_URL=

# Fleet API origin (e.g. http://127.0.0.1:4000). Set => live, read-only fleet data from
# GET /admin/fleet behind an admin token with fleet.view; unset => synthetic fixtures.
# Build-time value: rebuild after editing. The API must list this app's origin in CORS_ORIGIN.
VITE_FLEET_API_URL=
