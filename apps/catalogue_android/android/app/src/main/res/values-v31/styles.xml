<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) draws its own mandatory splash screen — an icon
     centered on a solid color — before LaunchTheme's windowBackground ever
     gets a chance to show, and the platform gives no way to skip that stage
     outright. windowSplashScreenAnimatedIcon is the real launcher icon: a
     transparent icon was tried here to hide that stage entirely, but with no
     branding at all a black screen with nothing on it reads as frozen/blank
     rather than "the app is opening" — the icon is the deliberate compromise.
     windowBackground is still set here too, for the brief LaunchTheme window
     between the platform splash being dismissed and Flutter's first frame. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
