{% comment %}
  Renders a "Try It On" button + upload modal for the current product.
  App-embed target: injected on every page by Shopify once the merchant
  toggles it on under Theme editor -> App embeds (no per-template block
  placement needed). Only renders on product pages (`product` is blank
  everywhere else) and only once the widget_key metafield exists (install
  incomplete, or metafield write failed) — a missing/broken button is
  safer on a live storefront than one that always errors.

  Note on the `placement_selector` setting below: it deliberately has no
  `default` key. Shopify's schema validator rejects `"default": ""` outright
  ("default can't be blank"), and any non-blank default pins new installs to one
  theme's markup — which is what silently broke placement for merchants who
  switched themes. Unset renders as empty, and tryon-widget.js reads empty as
  "auto-detect" and walks its own fallback selector chain.
{% endcomment %}

{%- assign widget_key = shop.metafields.aivastra.widget_key -%}
{%- if product != blank and widget_key != blank -%}
  <div
    class="aivastra-tryon"
    data-widget-key="{{ widget_key }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url }}"
    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}"
    {%- if customer -%}
      data-customer-id="{{ customer.id }}"
      data-customer-email="{{ customer.email }}"
    {%- endif -%}
    data-api-base="{{ block.settings.api_base | default: 'https://app.aivastra.com' }}"
    data-placement-selector="{{ block.settings.placement_selector }}"
    data-block-alignment="{{ block.settings.block_alignment }}"
    style="--aivastra-button-color: {{ block.settings.button_color }}; --aivastra-text-color: {{ block.settings.text_color }}; --aivastra-border-radius: {{ block.settings.border_radius }}px;"
  >
    {%- if block.settings.promo_text != blank -%}
      <p class="aivastra-tryon__promo">{{ block.settings.promo_text | escape }}</p>
    {%- endif -%}

    <button type="button" class="aivastra-tryon__button">
      {{ block.settings.button_text | default: 'Try It On' | escape }}
    </button>

    <div class="aivastra-tryon__modal" hidden>
      <div class="aivastra-tryon__modal-content">
        <div class="aivastra-tryon__modal-inner">
          <div class="aivastra-tryon__header">
            <div class="aivastra-tryon__header-main">
              <div>
                <p class="aivastra-tryon__heading">Try It On</p>
                <p class="aivastra-tryon__subheading">See how it looks on you</p>
              </div>
            </div>
            <div class="aivastra-tryon__header-history" hidden>
              <button type="button" class="aivastra-tryon__history-back" aria-label="Back">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              </button>
              <div>
                <p class="aivastra-tryon__heading">Your Try-Ons</p>
                <p class="aivastra-tryon__subheading">Results</p>
              </div>
            </div>
            <div class="aivastra-tryon__header-actions">
              <button type="button" class="aivastra-tryon__history-btn" aria-label="View history" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="aivastra-tryon__history-badge" hidden>0</span>
              </button>
              <button type="button" class="aivastra-tryon__close" aria-label="Close">&times;</button>
            </div>
          </div>

          <div class="aivastra-tryon__page aivastra-tryon__page--main">
            <div class="aivastra-tryon__step aivastra-tryon__step--upload">
              <div class="aivastra-tryon__step-indicator" aria-label="Step 1 of 2">
                <span class="aivastra-tryon__step-dot is-active">1</span>
                <span class="aivastra-tryon__step-line"></span>
                <span class="aivastra-tryon__step-dot">2</span>
              </div>

              <h2 class="aivastra-tryon__upload-title">Ready to try it on?</h2>
              <p class="aivastra-tryon__upload-lead">
                Upload your photo and see how it looks on you instantly
              </p>

              <div class="aivastra-tryon__avatar">
                <img class="aivastra-tryon__avatar-image" alt="" hidden />
              </div>

              <p class="aivastra-tryon__reuse-expired-note" hidden>
                Your previous photo expired — please upload a new one.
              </p>

              <div class="aivastra-tryon__button-stack">
                <label class="aivastra-tryon__choose-btn">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                  <strong>Choose Your Photo</strong>
                  <input type="file" accept="image/*" class="aivastra-tryon__file-input" />
                </label>
              </div>

              <p class="aivastra-tryon__legal">
                By using this service, you agree to our Terms and Privacy Policy.<br />
                AI can make mistakes.
              </p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--ready" hidden>
              <div class="aivastra-tryon__ready-preview">
                <img class="aivastra-tryon__ready-image" alt="" />
                <button type="button" class="aivastra-tryon__change-photo">Change Photo</button>
              </div>
              <button type="button" class="aivastra-tryon__cta">
                <span>{{ block.settings.button_text | default: 'Try It On' | escape }} Now</span>
              </button>
              <p class="aivastra-tryon__legal">
                By clicking "{{ block.settings.button_text | default: 'Try It On' | escape }}", you agree to our
                Terms and Privacy Policy.<br />
                AI can make mistakes.
              </p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--email" hidden>
              <h2 class="aivastra-tryon__upload-title">One quick thing</h2>
              <p class="aivastra-tryon__upload-lead aivastra-tryon__email-lead">
                Enter your email to continue.
              </p>
              <input
                type="email"
                class="aivastra-tryon__email-input"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
              <label class="aivastra-tryon__email-consent">
                <input type="checkbox" class="aivastra-tryon__email-consent-input" />
                <span>Email me offers and updates from this store.</span>
              </label>
              <p class="aivastra-tryon__email-error" hidden></p>
              <button type="button" class="aivastra-tryon__email-submit">Continue</button>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--progress" hidden>
              <div class="aivastra-tryon__progress-canvas">
                <p>{{ 'tryon.generating' | t }}</p>
                <div class="aivastra-tryon__progress-bar-track">
                  <div class="aivastra-tryon__progress-bar-fill"></div>
                </div>
              </div>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--pending" hidden>
              <p>{{ 'tryon.pending' | t }}</p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--result" hidden>
              <img class="aivastra-tryon__result-image" alt="{{ 'tryon.result_alt' | t }}" />
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--error" hidden>
              <p>{{ 'tryon.error' | t }}</p>
              <button type="button" class="aivastra-tryon__retry">
                {{ 'tryon.try_again' | t }}
              </button>
            </div>
          </div>

          <div class="aivastra-tryon__page aivastra-tryon__page--history" hidden>
            <div class="aivastra-tryon__history-list"></div>
            <p class="aivastra-tryon__history-empty" hidden>
              No try-ons yet — results you generate will show up here.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{ 'tryon-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tryon-widget.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Try It On",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "api_base",
      "label": "API base URL",
      "default": "https://app.aivastra.com"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promotional text above button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try It On"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "text",
      "id": "placement_selector",
      "label": "Insert button at CSS selector",
      "info": "Leave blank to place the button near the Buy button automatically. If it lands in the wrong spot on your theme, enter a CSS selector here to override."
    },
    {
      "type": "select",
      "id": "block_alignment",
      "label": "Position within that element",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    }
  ]
}
{% endschema %}
