{% comment %}
  The Try It On button as an app BLOCK; the merchant adds it in the product
  template (Add block). The corner icon on the product image comes from the Try
  It On app embed (App embeds panel) and opens the same try-on window.
{% endcomment %}

{% render 'tryon-widget', settings: block.settings, source: 'block' %}

{% schema %}
{
  "name": "Try It On button",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "paragraph",
      "content": "The Try It On button, shown exactly where you place it. Turn on the Try It On app embed too if you want a try-on icon on the product image."
    },
    {
      "type": "text",
      "id": "api_base",
      "label": "API base URL",
      "default": "https://app.aivastra.com"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promotional text above button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try It On"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon on the button",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "text_gradient",
      "label": "Text gradient (optional)",
      "info": "Pick a gradient to use instead of the text color. Leave empty for solid text."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Fill color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "button_gradient",
      "label": "Fill gradient (optional)",
      "info": "Pick a gradient to use instead of the fill color. Leave empty for a solid fill."
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "info": "Set above 0 to show a border in the color or gradient below. 0 means no border.",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "border_gradient",
      "label": "Border gradient (optional)",
      "info": "Pick a gradient to use instead of the border color. Leave empty for a solid border."
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "info": "Percent of the space the block sits in. 100 matches the Add to cart button.",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ]
}
{% endschema %}
