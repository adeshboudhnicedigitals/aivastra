{% comment %}
  The Try It On button as an app BLOCK; the merchant adds it in the product
  template (Add block). The corner icon on the product image comes from the Try
  It On app embed (App embeds panel) and opens the same try-on window.
{% endcomment %}

{% render 'tryon-widget', settings: block.settings, source: 'block' %}

{% schema %}
{
  "name": "Try It On button",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "paragraph",
      "content": "The Try It On button, shown exactly where you place it. Turn on the Try It On app embed too if you want a try-on icon on the product image."
    },
    {
      "type": "text",
      "id": "api_base",
      "label": "API base URL",
      "default": "https://app.aivastra.com"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promotional text above button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try It On"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon on the button",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "button_gradient",
      "label": "Button gradient (optional)",
      "info": "Pick a gradient to use instead of the button color. Leave empty for a solid button."
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Button width",
      "info": "Percent of the space the block sits in. 100 matches the Add to cart button.",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Button height",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ]
}
{% endschema %}
