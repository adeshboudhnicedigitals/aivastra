{% comment %}
  App EMBED (target: "body"): the merchant switches it on under App embeds; it
  renders a small icon over the product's main image and opens the same try-on
  window as the Try It On button block. If the block is on the page, the icon
  opens the block's window instead of its own.

  Only product pages render anything: `product` is blank everywhere else, and
  so is `widget_key` until install has finished writing the metafield.

  Rendered `hidden` on purpose: Liquid has no access to the merchant's
  Postgres activation state (global/selective mode, per-product/collection
  enables, exclusions) — only Shopify's own data and shop metafields, and we
  don't sync per-product metafields. tryon-widget.js calls
  GET .../customer/products/:id/enabled on load and un-hides this only when
  that product is actually enabled, so a disabled product's button never
  flashes into view before disappearing.
{% endcomment %}

{% render 'tryon-widget', settings: block.settings, source: 'embed' %}

{% schema %}
{
  "name": "Try It On",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "api_base",
      "label": "API base URL",
      "default": "https://app.aivastra.com"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "text",
      "id": "media_selector",
      "label": "Product image container (advanced)",
      "info": "Leave blank to place the icon on the top-right of your main product image automatically. If it lands in the wrong spot on your theme, enter a CSS selector for the element that wraps the product image."
    }
  ]
}
{% endschema %}
