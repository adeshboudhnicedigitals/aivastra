{% comment %}
  Renders a "Try It On" button + upload modal for the current product.

  App BLOCK (not an app embed): the merchant drags this into their product
  template in the theme editor, so it renders exactly where they put it. That
  is why there is no placement setting and no placement JS — the
  previous app-embed version injected at the end of <body> and then had to
  relocate itself through a chain of guessed CSS selectors, which broke every
  time a merchant switched themes.

  App blocks require an Online Store 2.0 (JSON) template. Vintage themes cannot
  accept them and are unsupported.

  `enabled_on.templates` pins this to product templates: `product` is blank
  everywhere else, so the guard below would render nothing anyway, and the
  block would just be dead weight in the theme editor's picker.
{% endcomment %}

{%- assign widget_key = shop.metafields.aivastra.widget_key -%}
{%- assign cfg = shop.metafields.aivastra.widget_config.value -%}
{%- if product != blank and widget_key != blank -%}
  <div
    class="aivastra-tryon"
    data-widget-key="{{ widget_key }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url }}"
    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}"
    {%- if customer -%}
      data-customer-id="{{ customer.id }}"
      data-customer-email="{{ customer.email }}"
    {%- endif -%}
    data-api-base="{{ block.settings.api_base | default: 'https://app.aivastra.com' | escape }}"
    style="--aivastra-button-color: {{ block.settings.button_color }}; --aivastra-text-color: {{ block.settings.text_color }}; --aivastra-border-radius: {{ block.settings.border_radius }}px;{% if cfg.theme.accentColor %} --aivastra-accent: {{ cfg.theme.accentColor | escape }};{% endif %}"
  >
    {%- if block.settings.promo_text != blank -%}
      <p class="aivastra-tryon__promo">{{ block.settings.promo_text | escape }}</p>
    {%- endif -%}

    <button type="button" class="aivastra-tryon__button">
      {{ block.settings.button_text | default: 'Try It On' | escape }}
    </button>

    <div class="aivastra-tryon__modal" hidden>
      <div class="aivastra-tryon__modal-content">
        <div class="aivastra-tryon__modal-inner">
          <div class="aivastra-tryon__header">
            <div class="aivastra-tryon__header-main">
              <div>
                <p class="aivastra-tryon__heading">{{ cfg.copy.heading | default: 'Try It On' | escape }}</p>
                <p class="aivastra-tryon__subheading">{{ cfg.copy.subheading | default: 'See how it looks on you' | escape }}</p>
              </div>
            </div>
            <div class="aivastra-tryon__header-actions">
              <button type="button" class="aivastra-tryon__back-btn" aria-label="Back" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
              </button>
              <button type="button" class="aivastra-tryon__history-btn" aria-label="View your try-ons" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="aivastra-tryon__history-badge" hidden>0</span>
              </button>
              <button type="button" class="aivastra-tryon__close" aria-label="Close">&times;</button>
            </div>
          </div>

          <div class="aivastra-tryon__page aivastra-tryon__page--main">
            <div class="aivastra-tryon__step aivastra-tryon__step--upload">
              <div class="aivastra-tryon__step-indicator" aria-label="Step 1 of 2">
                <span class="aivastra-tryon__step-dot is-active">1</span>
                <span class="aivastra-tryon__step-line"></span>
                <span class="aivastra-tryon__step-dot">2</span>
              </div>

              <h2 class="aivastra-tryon__upload-title">{{ cfg.copy.uploadTitle | default: 'Ready to try it on?' | escape }}</h2>
              <p class="aivastra-tryon__upload-lead">
                {{ cfg.copy.uploadLead | default: 'Upload your photo and see how it looks on you instantly' | escape }}
              </p>

              <div class="aivastra-tryon__avatar">
                <img class="aivastra-tryon__avatar-image" alt="" width="1" height="1" referrerpolicy="no-referrer" hidden />
              </div>

              <p class="aivastra-tryon__reuse-expired-note" hidden>
                Your previous photo expired — please upload a new one.
              </p>

              <div class="aivastra-tryon__button-stack">
                <label class="aivastra-tryon__choose-btn">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                  <strong>{{ cfg.copy.chooseLabel | default: 'Choose Your Photo' | escape }}</strong>
                  <input type="file" accept="image/*" class="aivastra-tryon__file-input" />
                </label>
              </div>

              <p class="aivastra-tryon__legal">
                {{ cfg.copy.legalText | default: 'By using this service, you agree to our Terms and Privacy Policy.' | escape }}<br />
                AI can make mistakes.
              </p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--ready" hidden>
              <div class="aivastra-tryon__ready-preview">
                <img class="aivastra-tryon__ready-image" alt="" width="1" height="1" referrerpolicy="no-referrer" />
                <button type="button" class="aivastra-tryon__change-photo">Change Photo</button>
              </div>
              <button type="button" class="aivastra-tryon__cta">
                <span>{{ cfg.copy.ctaLabel | default: 'Try It On Now' | escape }}</span>
              </button>
              <p class="aivastra-tryon__legal">
                {{ cfg.copy.legalText | default: 'By using this service, you agree to our Terms and Privacy Policy.' | escape }}<br />
                AI can make mistakes.
              </p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--email" hidden>
              <h2 class="aivastra-tryon__upload-title">One quick thing</h2>
              <p class="aivastra-tryon__upload-lead aivastra-tryon__email-lead">
                Enter your email to continue.
              </p>
              <input
                type="email"
                class="aivastra-tryon__email-input"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
              <label class="aivastra-tryon__email-consent">
                <input type="checkbox" class="aivastra-tryon__email-consent-input" />
                <span>Email me offers and updates from this store.</span>
              </label>
              <p class="aivastra-tryon__email-error" hidden></p>
              <button type="button" class="aivastra-tryon__email-submit">Continue</button>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--progress" hidden>
              <div class="aivastra-tryon__progress-canvas">
                {%- if cfg.copy.generatingText != blank -%}
                  <p class="aivastra-tryon__progress-message">{{ cfg.copy.generatingText | escape }}</p>
                {%- else -%}
                  <div class="aivastra-tryon__progress-rotator" aria-live="polite">
                    <p class="aivastra-tryon__progress-line is-active">Creating your try-on…</p>
                    <p class="aivastra-tryon__progress-line">Getting the fit just right…</p>
                    <p class="aivastra-tryon__progress-line">Working on the details…</p>
                    <p class="aivastra-tryon__progress-line">Almost there…</p>
                  </div>
                {%- endif -%}
                <div class="aivastra-tryon__progress-bar-track">
                  <div class="aivastra-tryon__progress-bar-fill"></div>
                </div>
              </div>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--pending" hidden>
              <p>{{ 'tryon.pending' | t }}</p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--result" hidden>
              <div class="aivastra-tryon__result-list"></div>
              <p class="aivastra-tryon__result-empty" hidden>
                No try-ons yet — results you generate will show up here.
              </p>
            </div>

            <div class="aivastra-tryon__step aivastra-tryon__step--error" hidden>
              <p>{{ cfg.copy.errorText | default: 'Something went wrong. Please try again.' | escape }}</p>
              <button type="button" class="aivastra-tryon__retry">
                {{ 'tryon.try_again' | t }}
              </button>
            </div>
          </div>

          <template class="aivastra-tryon__result-card-template">
            <div class="aivastra-tryon__result-card">
              <img class="aivastra-tryon__result-image" alt="{{ 'tryon.result_alt' | t }}" width="1" height="1" referrerpolicy="no-referrer" />

              <div class="aivastra-tryon__result-actions">
                {%- unless cfg.behavior.addToCart == false -%}
                  <button
                    type="button"
                    class="aivastra-tryon__add-to-cart"
                    data-default-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {{ cfg.behavior.addToCartLabel | default: 'Add to Cart' | escape }}
                  </button>
                {%- endunless -%}
                {%- unless cfg.behavior.share == false -%}
                  <button
                    type="button"
                    class="aivastra-tryon__share"
                    aria-label="{{ cfg.behavior.shareLabel | default: 'Share' | escape }}"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.2"/><circle cx="6" cy="12" r="2.2"/><circle cx="18" cy="19" r="2.2"/><path d="m8 11 7.8-4.6M8 13l7.8 4.6"/></svg>
                  </button>
                {%- endunless -%}
              </div>

              <p class="aivastra-tryon__cart-error" hidden></p>
              <span class="aivastra-tryon__share-flash" hidden></span>
              <a class="aivastra-tryon__view-cart" href="{{ routes.cart_url }}" hidden>View cart</a>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>

  {{ 'tryon-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tryon-widget.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Try It On",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "api_base",
      "label": "API base URL",
      "default": "https://app.aivastra.com"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promotional text above button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Try It On"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ]
}
{% endschema %}
