        }
      },
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"node\", box=~\"$box\"} / node_memory_MemTotal_bytes{job=\"node\", box=~\"$box\"}",
          "legendFormat": "{{box}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "Root disk used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "1 - node_filesystem_avail_bytes{job=\"node\", box=~\"$box\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"node\", box=~\"$box\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{box}}",
          "refId": "A"
        }
      ],
      "description": "Root filesystem (/). Model files live here on the GPU boxes; at 100% jobs fail."
