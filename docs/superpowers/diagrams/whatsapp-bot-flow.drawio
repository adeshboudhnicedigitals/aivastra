er acts here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="2260" width="230" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="seller waits, backend works" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="2260" width="230" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="backend only, no prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="2260" width="230" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="applies to every step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#3b5b8c;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="2260" width="230" height="30" as="geometry"/></mxCell><mxCell id="lg5" value="jumps to that state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="2260" width="230" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>