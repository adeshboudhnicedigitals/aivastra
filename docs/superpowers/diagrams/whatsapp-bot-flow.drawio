<mxfile host="app.diagrams.net">
  <diagram id="wa-bot-flow" name="WhatsApp bot flow">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" value="&lt;b&gt;WhatsApp catalog bot: accounts, states, buttons and every message text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;As built on dev, 2026-10-23 (catalogue engine: engine/engine.ts, copy.ts, inbound.ts). Text in quotes is sent verbatim. [Brackets] are buttons; list rows are named. Each line names the tap or event on it.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="1900" x="3530" y="920" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Message arrives&lt;/b&gt;&lt;br&gt;WhatsApp webhook&lt;br&gt;over 30 messages/min from one number: dropped, no reply" vertex="1">
          <mxGeometry height="82" width="330" x="3530" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Unknown number&lt;/b&gt;&lt;br&gt;no account row; never reaches the engine" vertex="1">
          <mxGeometry height="52" width="330" x="4070" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-4" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connect link sent (any message but a code)&lt;/b&gt;&lt;br&gt;&quot;Welcome to Ai Vastra! 👋&lt;br&gt;Create professional fashion catalogue images from your garment photos.&lt;br&gt;📸 AI model photos&lt;br&gt;🚫 No studio, no shoot day&lt;br&gt;⚡ Ready in minutes&lt;br&gt;To get started, connect your Ai Vastra account (or create one).&quot;&lt;br&gt;Button [Connect my account]; footer &quot;The link expires in 30 minutes.&quot;" vertex="1">
          <mxGeometry height="187" width="330" x="4610" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-5" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Web confirm page&lt;/b&gt;&lt;br&gt;seller opens the link, logs in, sees the masked number, taps Confirm" vertex="1">
          <mxGeometry height="67" width="330" x="5150" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-6" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;CONNECT &amp;lt;code&amp;gt;&lt;/b&gt;&lt;br&gt;code made in Settings, sent from the number, valid 10 min&lt;br&gt;seller taps Connect in Settings: WhatsApp opens with the text pre-filled" vertex="1">
          <mxGeometry height="97" width="330" x="4610" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-7" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Code rejected&lt;/b&gt;&lt;br&gt;expired or used: &quot;That code has expired or was already used. Open Settings on the Aivastra website and tap Connect WhatsApp again.&quot;&lt;br&gt;number on another account: &quot;This number is connected to another Aivastra account. Disconnect it there first.&quot;" vertex="1">
          <mxGeometry height="127" width="330" x="4070" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-8" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connected&lt;/b&gt;&lt;br&gt;&quot;You&#39;re all set! ✅&lt;br&gt;Your WhatsApp is now connected to your Ai Vastra account.&lt;br&gt;Send a garment photo whenever you are ready and I will turn it into catalogue images. 📸&lt;br&gt;Reply MENU to see your options, or STOP to pause messages.&quot;&lt;br&gt;If the profile mobile differs: &quot;Note: this WhatsApp number is different from the mobile number on your account (ending NNNN).&quot;&lt;br&gt;then MAIN_MENU. After a web confirm this is only pushed while the 24 h chat window is open." vertex="1">
          <mxGeometry height="217" width="330" x="5690" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-9" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connected number sends CONNECT &amp;lt;code&amp;gt;&lt;/b&gt;&lt;br&gt;&quot;This number is already connected to your Aivastra account.&quot;" vertex="1">
          <mxGeometry height="67" width="330" x="5690" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-10" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Opted out&lt;/b&gt;&lt;br&gt;seller types STOP:&lt;br&gt;&quot;You won&#39;t receive any more messages from Aivastra on WhatsApp. Your account and images are unchanged. Send START if you want to use the bot again.&quot;&lt;br&gt;no results, no notices until any message or START" vertex="1">
          <mxGeometry height="112" width="300" x="6230" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-11" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-3" value="number has no&lt;br&gt;account row">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-12" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-4" value="any other message:&lt;br&gt;bot sends the connect link">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-13" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-5" value="seller opens the&lt;br&gt;link, logs in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-14" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="seller taps Confirm:&lt;br&gt;&quot;Connected&quot;, then the menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-15" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.2;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-6" value="text is&lt;br&gt;CONNECT &lt;code&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-16" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.25;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="code valid:&lt;br&gt;&quot;Connected&quot;, then the menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-17" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-7" value="code invalid, or number&lt;br&gt;already on another account">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-18" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-10" value="types STOP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-19" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="any message or START:&lt;br&gt;bot is back on">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-20" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-9" value="sends CONNECT &lt;code&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-21" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-3" value="Disconnect in Settings: account row and stored number&lt;br&gt;are deleted, the next message starts over">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="5855" y="1000" />
              <mxPoint x="4235" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-22" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;MAIN_MENU&lt;/b&gt;&lt;br&gt;&quot;✨ Ai Vastra&lt;br&gt;What would you like to do?&quot;&lt;br&gt;[📸 New catalogue] [💳 My credits] [💬 Help]" vertex="1">
          <mxGeometry height="82" width="330" x="3530" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-23" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Credits / Help replies&lt;/b&gt;&lt;br&gt;[💳 My credits]: &quot;You have N credits. Buy more on the website: &amp;lt;pricing link&amp;gt;&quot;&lt;br&gt;[💬 Help]: &quot;Send a photo of your garment to start a catalog, or type MENU at any time. Need a person? &amp;lt;help link&amp;gt;&quot;&lt;br&gt;then the menu again" vertex="1">
          <mxGeometry height="127" width="330" x="3530" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-24" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GARMENT_PHOTO&lt;/b&gt;&lt;br&gt;&quot;Send a photo of your garment, laid flat and fully visible.&quot;&lt;br&gt;[Menu]" vertex="1">
          <mxGeometry height="82" width="330" x="4070" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-25" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;recognise garment kind&lt;/b&gt;&lt;br&gt;api → dispatcher → GPU classify; seller waits up to 12 s&lt;br&gt;photo stored first; &quot;Couldn&#39;t receive that photo. Please send it again.&quot; if the download fails twice" vertex="1">
          <mxGeometry height="97" width="330" x="4610" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-26" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;CONFIRM_KIND&lt;/b&gt;&lt;br&gt;&quot;I&#39;ve analysed the image and it looks like a [women&#39;s] &amp;lt;kind&amp;gt;.&lt;br&gt;Is this correct?&quot;&lt;br&gt;(gender shown only when the kind implies exactly one)&lt;br&gt;[Yes, continue] [No, different item]" vertex="1">
          <mxGeometry height="127" width="330" x="5150" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-27" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GENDER&lt;/b&gt;&lt;br&gt;&quot;Create this catalogue for:&quot;  (after [Yes, continue]: &quot;Great! 👍&lt;br&gt;Create this catalogue for:&quot;)&lt;br&gt;list [Choose]: Women · Men · Boys · Girls&lt;br&gt;(only the genders that have the recognised kind, when known)" vertex="1">
          <mxGeometry height="127" width="330" x="5690" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-28" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;kind → garment type&lt;/b&gt;&lt;br&gt;uses the recognised kind + gender&lt;br&gt;no kind, or the gender has none: the type list&lt;br&gt;kind found, type offered: load defaults&lt;br&gt;kind found, type not offered on WhatsApp: studio handoff" vertex="1">
          <mxGeometry height="112" width="330" x="5690" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-29" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GARMENT_TYPE&lt;/b&gt;&lt;br&gt;&quot;Which garment is it?&quot;&lt;br&gt;list [Choose]: one row per type, 9 per page, [More] row for the next 9&lt;br&gt;no types for the gender: &quot;Nothing is available for that choice right now.&quot; → MAIN_MENU" vertex="1">
          <mxGeometry height="112" width="330" x="5150" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-30" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Studio handoff (type can&#39;t be made here)&lt;/b&gt;&lt;br&gt;&quot;&amp;lt;Label&amp;gt; catalogs can&#39;t be made on WhatsApp yet. You can create one in the web studio: &amp;lt;draft link&amp;gt;&lt;br&gt;&lt;br&gt;Or choose another type.&quot;&lt;br&gt;(no type list to go back to: same text without the last line, then MAIN_MENU)" vertex="1">
          <mxGeometry height="127" width="330" x="5150" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-31" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;load defaults for the type&lt;/b&gt;&lt;br&gt;needs a model face, a background and at least one usable standard pose&lt;br&gt;else the studio handoff (reported to admins as no_face, no_background, no_poses…)" vertex="1">
          <mxGeometry height="97" width="330" x="5690" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-32" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_EXTRA_PHOTO&lt;/b&gt;&lt;br&gt;only for types needing a lower or third garment photo&lt;br&gt;&quot;I&#39;ll use the photo you sent as the &amp;lt;upper&amp;gt;. Now send a photo of the &amp;lt;lower garment | third garment&amp;gt;.&quot;&lt;br&gt;(first sentence only before the first extra photo)&lt;br&gt;[Menu]" vertex="1">
          <mxGeometry height="142" width="330" x="5150" y="2920" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-33" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_POSE_COUNT&lt;/b&gt;&lt;br&gt;&quot;Great! Let&#39;s create your catalogue. ✨&lt;br&gt;Category: &amp;lt;Women&amp;gt;&lt;br&gt;Garment: &amp;lt;type&amp;gt;&lt;br&gt;Credits per pose: N credits&lt;br&gt;Available balance: N credits&lt;br&gt;How many poses would you like to generate for your catalogue?&lt;br&gt;You can choose one option below. Each pose will use N credits.&quot;&lt;br&gt;list [Choose]: &quot;1 pose (N credits)&quot;, &quot;2 poses…&quot;, &quot;3 poses…&quot;, &quot;5 poses…&quot; (only counts the pool and balance allow)" vertex="1">
          <mxGeometry height="217" width="330" x="5690" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-34" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;NO_CREDITS&lt;/b&gt;&lt;br&gt;&quot;You don&#39;t have enough credits for this. Buy more on the website, then come back: &amp;lt;pricing link&amp;gt;&quot;&lt;br&gt;[Menu]" vertex="1">
          <mxGeometry height="82" width="330" x="5690" y="3680" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-35" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;start run (tap a count)&lt;/b&gt;&lt;br&gt;balance re-read; if short → NO_CREDITS&lt;br&gt;draws N poses at random, preferring ones not shown yet&lt;br&gt;one random face + background; lower and shoes = type default, else random&lt;br&gt;quote, deduct credits, write job, enqueue&lt;br&gt;a pose removed since: &quot;Those poses changed. Please choose again.&quot; → counts again&lt;br&gt;other rejection: its message, then MAIN_MENU" vertex="1">
          <mxGeometry height="172" width="330" x="5150" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-36" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;GENERATING&lt;/b&gt;&lt;br&gt;&quot;Generating your N poses...&lt;br&gt;We&#39;re creating your catalogue images.&lt;br&gt;This may take a few seconds.&quot;&lt;br&gt;any text meanwhile: &quot;Still generating: X of Y done.&quot;&lt;br&gt;no buttons" vertex="1">
          <mxGeometry height="127" width="330" x="4610" y="3300" as="geometry" />
        </mxCell>
