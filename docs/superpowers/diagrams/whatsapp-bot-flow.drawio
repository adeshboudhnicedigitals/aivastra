<mxfile host="app.diagrams.net"><diagram id="wa-bot-flow" name="WhatsApp bot flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;WhatsApp catalog bot: accounts, states, buttons&lt;/b&gt;&lt;br&gt;Each line names the tap or event on it, then what the bot does next." style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="n_IN" value="&lt;b&gt;Message arrives&lt;/b&gt;&lt;br&gt;WhatsApp webhook&lt;br&gt;30 messages/min per number" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="66" as="geometry"/></mxCell><mxCell id="n_UNK" value="&lt;b&gt;Unknown number&lt;/b&gt;&lt;br&gt;no account row" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="240" height="56" as="geometry"/></mxCell><mxCell id="n_LINK" value="&lt;b&gt;Connect link sent&lt;/b&gt;&lt;br&gt;valid 30 min" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="240" height="56" as="geometry"/></mxCell><mxCell id="n_WEB" value="&lt;b&gt;Web confirm page&lt;/b&gt;&lt;br&gt;seller logs in&lt;br&gt;sees the masked number" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="240" height="66" as="geometry"/></mxCell><mxCell id="n_CODE" value="&lt;b&gt;CONNECT &amp;lt;code&amp;gt;&lt;/b&gt;&lt;br&gt;code made in Settings&lt;br&gt;sent from the number, 10 min" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="240" height="66" as="geometry"/></mxCell><mxCell id="n_CONN" value="&lt;b&gt;Connected&lt;/b&gt;&lt;br&gt;engine handles messages" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1960" y="300" width="240" height="56" as="geometry"/></mxCell><mxCell id="n_OPT" value="&lt;b&gt;Opted out&lt;/b&gt;&lt;br&gt;no results, no notices" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1960" y="560" width="240" height="56" as="geometry"/></mxCell><mxCell id="n_B_CONN" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2330" y="316" width="130" height="56" as="geometry"/></mxCell><mxCell id="n_MM" value="&lt;b&gt;MAIN_MENU&lt;/b&gt;&lt;br&gt;[New catalog] [Credits] [Help]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="260" height="56" as="geometry"/></mxCell><mxCell id="n_AGP" value="&lt;b&gt;ASK_GARMENT_PHOTO&lt;/b&gt;&lt;br&gt;'Send a photo of your garment'&lt;br&gt;[Menu]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_AGEN" value="&lt;b&gt;ASK_GENDER&lt;/b&gt;&lt;br&gt;list 'Choose':&lt;br&gt;Women · Men · Boys · Girls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1080" y="780" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_RECOG" value="&lt;b&gt;classify garment&lt;/b&gt;&lt;br&gt;api → dispatcher → GPU&lt;br&gt;waits up to 12 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1600" y="780" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_CONF" value="&lt;b&gt;CONFIRM_GARMENT_TYPE&lt;/b&gt;&lt;br&gt;'Looks like X. Is that right?'&lt;br&gt;[Yes] [No, change] [Menu]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2200" y="780" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_AGT" value="&lt;b&gt;ASK_GARMENT_TYPE&lt;/b&gt;&lt;br&gt;list 'Choose': one row per type&lt;br&gt;[More] row when over 9 types" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1600" y="1100" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_LOAD" value="&lt;b&gt;load defaults&lt;/b&gt;&lt;br&gt;default face, templates,&lt;br&gt;pose pool, usable looks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2200" y="1100" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_EXTRA" value="&lt;b&gt;ASK_EXTRA_PHOTO&lt;/b&gt;&lt;br&gt;'Now send a photo of the …'&lt;br&gt;[Menu]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2200" y="1420" width="260" height="109" as="geometry"/></mxCell><mxCell id="n_PICK" value="&lt;b&gt;PICK_LOOKS&lt;/b&gt;&lt;br&gt;first page: price and balance, [Change garment] [Menu]&lt;br&gt;pose cards (10 per page), each with [Select]&lt;br&gt;[More] (if another page) [Generate] [Clear]&lt;br&gt;after each tap: 'N selected · X credits' [Generate] [Clear]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="1420" width="520" height="109" as="geometry"/></mxCell><mxCell id="n_NOCR" value="&lt;b&gt;NO_CREDITS&lt;/b&gt;&lt;br&gt;'You don't have enough credits'&lt;br&gt;top-up link on the web&lt;br&gt;[Menu]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="1420" width="260" height="109" as="geometry"/></mxCell><mxCell id="n_START" value="&lt;b&gt;start runs&lt;/b&gt;&lt;br&gt;quote every template, deduct&lt;br&gt;credits, write job, enqueue" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2200" y="1960" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_GEN" value="&lt;b&gt;GENERATING&lt;/b&gt;&lt;br&gt;status only, no buttons" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1600" y="1960" width="260" height="56" as="geometry"/></mxCell><mxCell id="n_RENDER" value="&lt;b&gt;render and deliver&lt;/b&gt;&lt;br&gt;dispatcher + GPU render,&lt;br&gt;images sent, refund on failure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1080" y="1960" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_DELIV" value="&lt;b&gt;DELIVERED&lt;/b&gt;&lt;br&gt;'All done. What next?'&lt;br&gt;[Retry failed] only if some failed&lt;br&gt;[More poses]&lt;br&gt;[Menu] if any failed, else [New catalog]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="1960" width="260" height="96" as="geometry"/></mxCell><mxCell id="n_G_ANY" value="&lt;b&gt;Any step: typed exit word&lt;/b&gt;&lt;br&gt;menu · restart · cancel · exit&lt;br&gt;quit · back · hi · hello" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#3b5b8c;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="260" height="66" as="geometry"/></mxCell><mxCell id="n_G_PHOTO" value="&lt;b&gt;Any step with no question&lt;/b&gt;&lt;br&gt;MAIN_MENU, photo prompt,&lt;br&gt;NO_CREDITS, GENERATING, DELIVERED&lt;br&gt;a photo starts a new catalog" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#3b5b8c;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1080" y="1100" width="260" height="81" as="geometry"/></mxCell><mxCell id="n_G_MISC" value="&lt;b&gt;Also in every step&lt;/b&gt;&lt;br&gt;stray text, question step:&lt;br&gt;'Please use the options above'&lt;br&gt;stray text, idle step: prompt again&lt;br&gt;old button: says so, shows step again&lt;br&gt;video or document: 'send a JPG or PNG'&lt;br&gt;help: sends help link, step unchanged" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#3b5b8c;dashed=1;fontSize=11;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="260" height="126" as="geometry"/></mxCell><mxCell id="n_B_AGP" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="537" y="960" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_RECOG" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1655" y="640" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_CONF" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2255" y="640" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_AGT" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="1250" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_LOAD" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2330" y="1290" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_EXTRA" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2330" y="1650" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_PICK" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1711" y="1290" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_NOCR" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1005" y="1650" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_D_MENU" value="→ MAIN_MENU" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="1790" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_D_NEW" value="→ ASK_GARMENT_PHOTO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="706" y="1790" width="170" height="56" as="geometry"/></mxCell><mxCell id="n_B_D_POSES" value="→ PICK_LOOKS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="2160" width="150" height="56" as="geometry"/></mxCell><mxCell id="n_B_D_RETRY" value="→ start runs" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2f4;strokeColor=#5a6872;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="2002" width="150" height="56" as="geometry"/></mxCell><mxCell id="e0" value="number has no&lt;br&gt;account row" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_IN" target="n_UNK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="any other message:&lt;br&gt;bot sends a connect&lt;br&gt;link (30 min)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_UNK" target="n_LINK"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="328"/><mxPoint x="840" y="178"/></Array></mxGeometry></mxCell><mxCell id="e2" value="seller opens the&lt;br&gt;link, logs in" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_LINK" target="n_WEB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="seller taps Confirm:&lt;br&gt;bot says 'Connected',&lt;br&gt;then shows the menu" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_WEB" target="n_CONN"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="183"/><mxPoint x="1830" y="314"/></Array></mxGeometry></mxCell><mxCell id="e4" value="seller taps Connect in&lt;br&gt;Settings: WhatsApp opens&lt;br&gt;with 'CONNECT &amp;lt;code&amp;gt;'" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_UNK" target="n_CODE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="483"/></Array></mxGeometry></mxCell><mxCell id="e5" value="bot redeems the code&lt;br&gt;(10 min): 'Connected',&lt;br&gt;then shows the menu" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_CODE" target="n_CONN"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1790" y="483"/><mxPoint x="1790" y="342"/></Array></mxGeometry></mxCell><mxCell id="e6" value="types stop: bot confirms,&lt;br&gt;nothing more is sent" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_CONN" target="n_OPT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="any message or start:&lt;br&gt;bot is back on" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_OPT" target="n_CONN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Disconnect in Settings: the account row and the stored&lt;br&gt;number are deleted, the next message starts over" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_CONN" target="n_UNK"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2080" y="70"/><mxPoint x="600" y="70"/></Array></mxGeometry></mxCell><mxCell id="e9" value="bot sends the menu;&lt;br&gt;then every message&lt;br&gt;goes to the engine" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_CONN" target="n_B_CONN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="tap [New catalog]:&lt;br&gt;bot asks for a&lt;br&gt;garment photo" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_MM" target="n_AGP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="send a photo:&lt;br&gt;bot stores it and&lt;br&gt;asks who the catalog&lt;br&gt;is for" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_AGP" target="n_AGEN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="tap [Menu]" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_AGP" target="n_B_AGP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="tap [Credits]: bot&lt;br&gt;replies with balance and&lt;br&gt;pricing link; menu again" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_MM" target="n_MM"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="66" y="720"/><mxPoint x="118" y="720"/></Array></mxGeometry></mxCell><mxCell id="e14" value="tap [Help]: bot sends&lt;br&gt;the help link;&lt;br&gt;menu again" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_MM" target="n_MM"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="222" y="720"/><mxPoint x="274" y="720"/></Array></mxGeometry></mxCell><mxCell id="e15" value="send a photo from the menu:&lt;br&gt;skips the photo prompt" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_MM" target="n_AGEN"><mxGeometry relative="1"