<mxfile host="app.diagrams.net">
  <diagram id="wa-bot-flow" name="WhatsApp bot flow">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" value="&lt;b&gt;WhatsApp catalog bot: accounts, states, buttons and every message text&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;As built on dev, 2026-10-27 (catalogue engine: engine/engine.ts, copy.ts, inbound.ts, baskets.ts). Text in quotes is sent verbatim. [Brackets] are buttons; list rows are named. Each line names the tap or event on it. Only single-image garment types are offered, so the extra-photo step is never reached and is not drawn.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="1900" x="3530" y="920" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Message arrives&lt;/b&gt;&lt;br&gt;WhatsApp webhook&lt;br&gt;over 30 messages/min from one number: dropped, no reply" vertex="1">
          <mxGeometry height="82" width="330" x="3530" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Unknown number&lt;/b&gt;&lt;br&gt;no account row; never reaches the engine" vertex="1">
          <mxGeometry height="52" width="330" x="4070" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-4" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connect link sent (any message but a code)&lt;/b&gt;&lt;br&gt;&quot;Welcome to Ai Vastra! 👋&lt;br&gt;Create AI fashion catalogues right here on WhatsApp.&quot;&lt;br&gt;Button [Connect my account]; footer &quot;The link expires in 30 minutes.&quot;" vertex="1">
          <mxGeometry height="187" width="330" x="4610" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-5" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Web confirm page&lt;/b&gt;&lt;br&gt;seller opens the link, logs in, sees the masked number, taps Confirm" vertex="1">
          <mxGeometry height="67" width="330" x="5150" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-6" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;CONNECT &amp;lt;code&amp;gt;&lt;/b&gt;&lt;br&gt;code made in Settings, sent from the number, valid 10 min&lt;br&gt;seller taps Connect in Settings: WhatsApp opens with the text pre-filled" vertex="1">
          <mxGeometry height="97" width="330" x="4610" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-7" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Code rejected&lt;/b&gt;&lt;br&gt;expired or used: &quot;That code has expired or was already used. Open Settings on the Aivastra website and tap Connect WhatsApp again.&quot;&lt;br&gt;number on another account: &quot;This number is connected to another Aivastra account. Disconnect it there first.&quot;" vertex="1">
          <mxGeometry height="127" width="330" x="4070" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-8" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connected&lt;/b&gt;&lt;br&gt;&quot;You&#39;re connected! 🎉&quot;&lt;br&gt;If the profile mobile differs: &quot;Note: this WhatsApp number is different from the mobile number on your account (ending NNNN).&quot;&lt;br&gt;then MAIN_MENU. After a web confirm this is only pushed while the 24 h chat window is open." vertex="1">
          <mxGeometry height="217" width="330" x="5690" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-9" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Connected number sends CONNECT &amp;lt;code&amp;gt;&lt;/b&gt;&lt;br&gt;not special: treated as ordinary text, so the current step is shown again" vertex="1">
          <mxGeometry height="67" width="330" x="5690" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-10" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Opted out&lt;/b&gt;&lt;br&gt;seller types STOP:&lt;br&gt;&quot;Paused. Send START to resume.&quot;&lt;br&gt;no results, no notices until any message or START" vertex="1">
          <mxGeometry height="112" width="300" x="6230" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-11" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-3" value="number has no&lt;br&gt;account row">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-12" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-4" value="any other message:&lt;br&gt;bot sends the connect link">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-13" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-5" value="seller opens the&lt;br&gt;link, logs in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-14" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="seller taps Confirm:&lt;br&gt;&quot;Connected&quot;, then the menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-15" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.2;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-6" value="text is&lt;br&gt;CONNECT &lt;code&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-16" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.25;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="code valid:&lt;br&gt;&quot;Connected&quot;, then the menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-17" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;" target="U-Jg9Jrtenf92Qa0-zKH-7" value="code invalid, or number&lt;br&gt;already on another account">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-18" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-10" value="types STOP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-19" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-8" value="any message or START:&lt;br&gt;bot is back on">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-20" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-9" value="sends CONNECT &lt;code&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-21" edge="1" parent="1" source="U-Jg9Jrtenf92Qa0-zKH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16212b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="U-Jg9Jrtenf92Qa0-zKH-3" value="Disconnect in Settings: account row and stored number&lt;br&gt;are deleted, the next message starts over">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="5855" y="1000" />
              <mxPoint x="4235" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-22" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#d7efec;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;MAIN_MENU&lt;/b&gt;&lt;br&gt;&quot;What would you like to do?&quot;&lt;br&gt;[New catalogue] [Credits] [Help]" vertex="1">
          <mxGeometry height="82" width="330" x="3530" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-23" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Credits / Help replies&lt;/b&gt;&lt;br&gt;[Credits]: &quot;You have N credits remaining. 💳&lt;br&gt;Buy more on the website: &amp;lt;pricing link&amp;gt;&quot;&lt;br&gt;[Help]: &quot;Send a garment photo to start. Type MENU any time. Need a person? &amp;lt;help link&amp;gt;&quot;&lt;br&gt;At the photo prompt the reply carries &quot;Send a garment photo to start.&quot; in the same message; while generating, the reply only; any other step: the step is shown again, draft kept" vertex="1">
          <mxGeometry height="150" width="330" x="3530" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-24" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GARMENT_PHOTO&lt;/b&gt;&lt;br&gt;&quot;Let&#39;s create your catalogue! ✨&lt;br&gt;Upload a clear photo of your garment.&quot;&lt;br&gt;[Exit]" vertex="1">
          <mxGeometry height="82" width="330" x="4070" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-25" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;recognise baskets&lt;/b&gt;&lt;br&gt;runs once the gender is tapped; the seller waits up to 12 s&lt;br&gt;the api sends that gender&#39;s single-image types, the classifier scores them, the api adds the probabilities per basket and keeps the top 4&lt;br&gt;top basket below 0.5, or any failure: no guess, the list" vertex="1">
          <mxGeometry height="127" width="330" x="5150" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-26" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;CONFIRM_BASKET&lt;/b&gt;&lt;br&gt;&quot;This looks like &amp;lt;basket&amp;gt;. Is that right?&quot;&lt;br&gt;[Yes, continue] [Choose garment type] [Menu]" vertex="1">
          <mxGeometry height="127" width="330" x="5690" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-85" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;CHOOSE_BASKET&lt;/b&gt;&lt;br&gt;&quot;No problem! Select the correct garment type.&quot;&lt;br&gt;list [Choose]: up to 3 other baskets, then [Something else]" vertex="1">
          <mxGeometry height="112" width="330" x="5690" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-27" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GENDER&lt;/b&gt;&lt;br&gt;&quot;Who is this catalogue for?&quot;&lt;br&gt;list [Choose]: Women · Men · Boys · Girls" vertex="1">
          <mxGeometry height="112" width="330" x="4610" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-28" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;basket → type&lt;/b&gt;&lt;br&gt;runs as the first of the basket&#39;s types the bot can offer, representative first&lt;br&gt;basket removed since: the list&lt;br&gt;none offerable: studio handoff, reason reported to admins" vertex="1">
          <mxGeometry height="127" width="330" x="5150" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-29" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_GARMENT_TYPE&lt;/b&gt;&lt;br&gt;&quot;Which garment is it?&quot;&lt;br&gt;list [Choose]: baskets first, then types in no basket; 9 per page, then [More]&lt;br&gt;nothing offered for the gender: &quot;Nothing is available for that choice right now.&quot; → MAIN_MENU" vertex="1">
          <mxGeometry height="127" width="330" x="6230" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-30" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Studio handoff (type can&#39;t be made here)&lt;/b&gt;&lt;br&gt;&quot;&amp;lt;Label&amp;gt; catalogs can&#39;t be made on WhatsApp yet. You can create one in the web studio: &amp;lt;draft link&amp;gt;&lt;br&gt;&lt;br&gt;Or choose another type.&quot;&lt;br&gt;(no type list to go back to: same text without the last line, then MAIN_MENU)" vertex="1">
          <mxGeometry height="127" width="330" x="5150" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-31" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;load defaults for the type&lt;/b&gt;&lt;br&gt;needs a model face, a background and at least one usable standard pose&lt;br&gt;else the studio handoff (reported to admins as no_face, no_background, no_poses…)" vertex="1">
          <mxGeometry height="97" width="330" x="5690" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-33" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;ASK_POSE_COUNT&lt;/b&gt;&lt;br&gt;&quot;How many poses would you like?&lt;br&gt;Each pose uses N credits.&quot;&lt;br&gt;list [Choose]: &quot;1 pose · N credits&quot;, &quot;2 poses · N credits&quot;, &quot;3 poses · N credits&quot;, &quot;5 poses · N credits&quot; (only counts the pool and balance allow)" vertex="1">
          <mxGeometry height="150" width="330" x="5690" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-34" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16212b;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;NO_CREDITS&lt;/b&gt;&lt;br&gt;&quot;Not enough credits. Top up: &amp;lt;pricing link&amp;gt;&quot;&lt;br&gt;[Menu]" vertex="1">
          <mxGeometry height="82" width="330" x="5690" y="3680" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-35" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;start run (tap a count)&lt;/b&gt;&lt;br&gt;balance re-read; if short → NO_CREDITS&lt;br&gt;draws N poses at random, preferring ones not shown yet&lt;br&gt;one random face + background; lower and shoes = type default, else random&lt;br&gt;quote, deduct credits, write job, enqueue&lt;br&gt;a pose removed since: &quot;Not available right now. Please pick again.&quot; → counts again&lt;br&gt;other rejection: its message, then MAIN_MENU" vertex="1">
          <mxGeometry height="172" width="330" x="5150" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-36" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fbecd2;strokeColor=#a15c07;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;GENERATING&lt;/b&gt;&lt;br&gt;&quot;Creating your N poses now. ✨&quot;&lt;br&gt;locked until the run finishes (see Generating lock): any text gets &quot;Still generating: X of Y done.&quot;&lt;br&gt;no buttons" vertex="1">
          <mxGeometry height="142" width="330" x="4610" y="3300" as="geometry" />
        </mxCell>
        <mxCell id="U-Jg9Jrtenf92Qa0-zKH-37" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f1f4f6;strokeColor=#5a6872;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;render and deliver&lt;/b&gt;&lt;br&gt;dispatcher picks an idle GPU worker; images sent one by one, no caption&lt;br&gt;after the last image the bot waits for WhatsApp to report it delivered (up to 8 s, WHATSAPP_IMAGE_DELIVERY_WAIT_MS, 0 = off) so the closing message arrives after it&lt;br&gt;24 h window closed: one paid template notice per run (WHATSAPP_RESULTS_TEMPLATE), images wait for the seller&#39;s next message&lt;br&gt;a failed image is refunded" vertex="1">
          <mxGeometry height="190" width="330" x="4070" y="3300" as="geometry" />
        </mxCell>
