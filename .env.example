# ---- Node ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Postgres ----
POSTGRES_USER=tryon
POSTGRES_PASSWORD=tryon_dev_pw
POSTGRES_DB=tryon_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://tryon:tryon_dev_pw@127.0.0.1:5432/tryon_dev

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- MinIO (local R2 stub) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin_dev_pw
R2_BUCKET=virtual-tryon-dev
R2_ENDPOINT=http://127.0.0.1:9000
R2_PUBLIC_URL=http://127.0.0.1:9000/virtual-tryon-dev
R2_FORCE_PATH_STYLE=true
# (Despite the names, R2_* above is local MinIO — the asset backend.)

# ---- User storage: real Cloudflare R2 (optional) ----
# Leave all blank to keep every object on local MinIO. To test the R2 split
# locally, point these at a DEV-ONLY bucket with an API token scoped to that
# bucket alone — never production's (local `pnpm dev` runs the upload sweeper,
# which deletes inputs/ objects this database doesn't reference).
# Runbook: docs/r2-user-storage-runbook.md · verify with: pnpm --filter @aivastra/api check:storage
USER_STORAGE_ENDPOINT=
USER_STORAGE_ACCESS_KEY_ID=
USER_STORAGE_SECRET_ACCESS_KEY=
USER_STORAGE_BUCKET=
USER_STORAGE_PUBLIC_URL=
USER_STORAGE_READ_FALLBACK=true

# ---- Cloudflare Tunnel / Workers ----
# Worker VPS URL — Nginx HTTPS endpoint on GPU VPS
# Dev: https://<VPS_IP>  (self-signed cert + NODE_TLS_REJECT_UNAUTHORIZED=0)
# Prod: https://worker-a.yourdomain.com  (real cert, remove NODE_TLS_REJECT_UNAUTHORIZED)
WORKER_IDS=worker-a
WORKER_A_URL=https://REPLACE-WITH-VPS-IP-OR-DOMAIN
# WORKER_B_URL=https://host:nginx-port   (Nginx listener → proxies to ComfyUI internal port)
# WORKER_C_URL=https://...
# Nginx X-Api-Key secret — generate with: openssl rand -hex 32
WORKER_API_KEY=
# Per-worker key override (optional) — falls back to WORKER_API_KEY when unset
# WORKER_B_API_KEY=
# WORKER_C_API_KEY=
# Dev only — disable TLS cert verification for self-signed certs. REMOVE in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ---- Auth ----
# Min 32 chars (HS256 ≥256-bit). Generate: openssl rand -base64 48
JWT_SECRET=change_me_dev_only_min_32_chars_long!!
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=1h
# Min 32 chars — used to sign cookies (httpOnly access/refresh tokens)
COOKIE_SECRET=change_me_dev_only_cookie_min_32_chars!!

# ---- Ports ----
API_PORT=4000
WEB_PORT=3000
DISPATCHER_HEALTH_PORT=4100

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Admin ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_dev_only

# ---- Chatbot ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHATBOT_PORT=4200
CHATBOT_SERVICE_TOKEN=change_me_min_16_chars!!
CHATBOT_URL=http://localhost:4200
NEXT_PUBLIC_CHATBOT_URL=http://localhost:4200
VITE_CHATBOT_URL=http://localhost:4200
CHATBOT_TOP_K=5
CHATBOT_SIMILARITY_THRESHOLD=0.4
CHATBOT_FALLBACK_LIMIT=2
CHATBOT_IDLE_TIMEOUT_MIN=30
CHATBOT_RESOLVED_CLOSE_TIMEOUT_MIN=10080
CHATBOT_MAX_TOOL_ITERATIONS=4

# ---- ComfyUI ----
NODE_ENV=development
PORT=3000
COMFY_URL=http://127.0.0.1:8188
COMFY_API_KEY=

# ---- Google OAuth ----
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI to register: http://localhost:4000/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
WEB_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@yourdomain.com

# ---- Observability (Grafana Cloud, free tier) ----
# Optional locally — only needed to test the Alloy agent shipping to Grafana Cloud.
# See docs/observability.md for where to find these. Leave blank to skip Alloy.
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=
# ---- Catalog Video (PixVerse) ----
# Image-to-video generation. Runs on its own jobs:video Redis lane — no GPU worker
# involved — so VIDEO_CONCURRENCY is independent of the ComfyUI worker count and
# should match the concurrency limit of your PixVerse plan.
PIXVERSE_API_KEY=
PIXVERSE_API_BASE_URL=https://app-api.pixverse.ai
PIXVERSE_POLL_INTERVAL_MS=5000
# Deliberately generous — not tuned to any observed generation time. A timeout
# that's too short makes the dispatcher give up and retry a generation PixVerse
# is about to finish and bill for anyway, burning real PixVerse credits on a
# video that's discarded unseen (1080p/15s took 3m24s-3m30s and got cut off by
# the old 180000 default). This exists only so a task truly stuck on PixVerse's
# side eventually frees its VIDEO_CONCURRENCY slot, not as a per-job target.
PIXVERSE_POLL_TIMEOUT_MS=1800000
VIDEO_CONCURRENCY=5

# ---- Local prod-snapshot sync (optional, dev-only) ----
# Pulls a periodic, encrypted export of production data + assets so a fresh
# checkout doesn't have to be hand-built through the admin panel. See
# docs/local-dev-snapshot-runbook.md. Credentials below are handed out
# out-of-band (1Password or equivalent) by whoever runs
# `make export-prod-snapshot` on the VPS -- never commit real values here.
# Public MinIO proxy for prod, same one CLAUDE.md documents for the live
# bucket -- confirmed to route correctly (2026-09-03). KNOWN BROKEN:
# pull-prod-snapshot.sh's mc-based steps (both the dump download and the
# asset mirror) fail against this value -- see the warning at the top of
# that script for why, and docs/local-dev-snapshot-runbook.md. Not yet
# fixed; do not expect `make sync-prod-snapshot` to work end to end yet.
DEV_SNAPSHOT_ENDPOINT=https://app.aivastra.com/minio
DEV_SNAPSHOT_BUCKET=virtual-tryon-dev-snapshot
DEV_SNAPSHOT_ACCESS_KEY_ID=
DEV_SNAPSHOT_SECRET_ACCESS_KEY=
# Path to your own age private key (generate with:
# age-keygen -o ~/.config/age/aivastra-dev.key). Give the operator the
# matching public key to add to scripts/local-sync/age-recipients.txt.
DEV_SNAPSHOT_AGE_IDENTITY=

# Shopify hold-until-paid (see .env.production.example)
SHOPIFY_HOLD_UNTIL_PAID=

# Comma-separated user ids allowed to send /v1/dev/tryon jobs to the dedicated
# 'inhouse' worker lane (workers tagged only 'inhouse' in admin). Empty = nobody.
INHOUSE_USER_IDS=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_ORG_ID=
# Grant credit packs at approval as always, then CONFIRM afterwards that Shopify collected
# payment (Partner API sale): UNVERIFIED -> PAID, or NOT_RECEIVED after the window. Only the
# literal 'true' enables it. Needs SHOPIFY_PARTNER_* above. Ignored while SHOPIFY_HOLD_UNTIL_PAID=true.
SHOPIFY_VERIFY_PAYMENTS=
# Minutes after approval before a missing sale is called "not received" (default 180, min 60).
SHOPIFY_PAYMENT_VERIFY_WINDOW_MINUTES=
# WhatsApp catalog bot — literal 'true' only. Display number is digits only.
MESSAGING_WHATSAPP_ENABLED=
WHATSAPP_DISPLAY_NUMBER=
# WhatsApp Cloud API. The access token is a system-user permanent token in production.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_RESULTS_TEMPLATE=
# literal 'true' to enable; needs the dispatcher classify lane (plan 5)
GARMENT_RECOGNITION_ENABLED=
