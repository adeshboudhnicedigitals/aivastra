# ---- Node ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Postgres ----
POSTGRES_USER=tryon
POSTGRES_PASSWORD=tryon_dev_pw
POSTGRES_DB=tryon_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://tryon:tryon_dev_pw@127.0.0.1:5432/tryon_dev

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- MinIO (local R2 stub) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pw
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin_dev_pw
R2_BUCKET=virtual-tryon-dev
R2_ENDPOINT=http://127.0.0.1:9000
R2_PUBLIC_URL=http://127.0.0.1:9000/virtual-tryon-dev
R2_FORCE_PATH_STYLE=true

# ---- Cloudflare Tunnel / Workers ----
WORKER_A_URL=https://worker-a.tryon.example.com
WORKER_B_URL=https://worker-b.tryon.example.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ---- Auth ----
JWT_SECRET=change_me_dev_only
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ---- Ports ----
API_PORT=4000
WEB_PORT=3000
DISPATCHER_HEALTH_PORT=4100

# ---- Admin ----
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_dev_only
